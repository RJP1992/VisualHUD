<UserControl x:Class="SwbfHudEditor.App.Views.EventsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252a30">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,6,6,4">
            <CheckBox x:Name="SimulateBox" Content="Simulate the game's events" Foreground="#d4e8ff"
                      Checked="SimulateBox_Changed" Unchecked="SimulateBox_Changed"
                      ToolTip="Off: every element shows, as an editor wants. On: an element shows only once its EventEnable event has been sent after its EventDisable one, as in the game, and values, texts, colours, textures, models and positions follow the events sent." />
            <WrapPanel Margin="0,6,0,0">
                <Button Content="Initialize" Click="Initialize_Click" Padding="8,1" Margin="0,0,4,4"
                        ToolTip="Send &quot;initialize&quot;, as the HUD does when it starts." />
                <Button Content="On foot" Click="OnFoot_Click" Padding="8,1" Margin="0,0,4,4"
                        ToolTip="Send what the game would have by now for a soldier spawned on foot: initialize, spawn, weapons, full health and energy, ammo, the reticule, team reinforcements." />
                <Button Content="Show selected" Click="ShowSelected_Click" Padding="8,1" Margin="0,0,4,4"
                        ToolTip="Send the EventEnable events of the selected element and the groups above it." />
                <Button Content="Clear" Click="Clear_Click" Padding="8,1" Margin="0,0,4,4"
                        ToolTip="Forget every event sent: everything starts hidden again." />
            </WrapPanel>
            <TextBox x:Name="FilterBox" Margin="0,2,0,0" TextChanged="FilterBox_TextChanged"
                     ToolTip="Show events whose name contains this." />
            <TextBlock Text="Type a value and press Enter, or Send to send it again (it then counts as the latest)." Foreground="#888"
                       FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <ListView x:Name="EventList" Background="#1e2227" Foreground="#d4e8ff" BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="ToolTip" Value="{Binding Details}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Order}" Foreground="#ffb347" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Event" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="Consolas, Cascadia Mono, Menlo, monospace" Foreground="{Binding NameBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="56" DisplayMemberBinding="{Binding TypeName}" />
                    <GridViewColumn Header="Value" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Suggestions}" MinWidth="120" KeyDown="Value_KeyDown"
                                          SelectionChanged="Value_SelectionChanged" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="52">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Send" Click="Send_Click" Padding="6,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Now" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Current}" Foreground="#9fd49f" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
