<UserControl x:Class="SwbfHudEditor.App.Views.FindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SwbfHudEditor.App.Views"
             Background="{StaticResource PanelBrush}">
    <UserControl.Resources>
        <!-- The grey word in an empty box. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
            <Grid Margin="0,0,0,4">
                <TextBox x:Name="FindBox" Padding="6,3" FontFamily="{StaticResource MonoFont}" TextChanged="Query_Changed"
                         PreviewKeyDown="FindBox_PreviewKeyDown"
                         ToolTip="Text to find in the arguments of the files opened: element names, event names, textures, text keys. The transform files loaded with them are left alone unless opened too." />
                <TextBlock x:Name="FindHint" Text="Find" Style="{StaticResource Hint}" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <TextBox x:Name="ReplaceBox" Padding="6,3" FontFamily="{StaticResource MonoFont}" TextChanged="Replacement_Changed"
                         ToolTip="What the found text becomes. Empty takes it out." />
                <TextBlock x:Name="ReplaceHint" Text="Replace with" Style="{StaticResource Hint}" />
            </Grid>
            <WrapPanel>
                <CheckBox x:Name="MatchCaseBox" Content="Match case" Margin="0,0,12,4" Checked="Query_Changed" Unchecked="Query_Changed"
                          ToolTip="Upper and lower case must match." />
                <CheckBox x:Name="WholeValueBox" Content="Whole value" Margin="0,0,12,4" Checked="Query_Changed" Unchecked="Query_Changed"
                          ToolTip="Only arguments that are the text and nothing more, as one event or one element's name; otherwise the text is found inside them too." />
                <CheckBox x:Name="AllValuesBox" Content="Numbers and words" Margin="0,0,0,4" Checked="Query_Changed" Unchecked="Query_Changed"
                          ToolTip="Look in numbers and bare words (true, false) too, not only in strings. A number replaced must still be a number." />
            </WrapPanel>
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="ReplaceButton" DockPanel.Dock="Right" Content="Replace" Click="Replace_Click" IsEnabled="False" Margin="8,0,0,0"
                        Padding="10,2" ToolTip="Replace the text in every ticked match, in one undo step." />
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                           Text="Type text to find it in the files opened." />
            </DockPanel>
        </StackPanel>
        <!-- The matches under their elements: the line with the text marked, and what it becomes. -->
        <ListBox x:Name="MatchList" SelectionMode="Single" SelectionChanged="MatchList_SelectionChanged"
                 MouseDoubleClick="MatchList_MouseDoubleClick" KeyDown="MatchList_KeyDown"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="ToolTip" Value="{Binding Details}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,8,4,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Name.File}" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name.Title}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,6,0"
                                  ToolTip="Replace in this one" />
                        <StackPanel>
                            <views:MatchText Segments="{Binding Segments}" FontFamily="{StaticResource MonoFont}"
                                             Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding After}" Foreground="{Binding AfterBrush}" FontFamily="{StaticResource MonoFont}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
