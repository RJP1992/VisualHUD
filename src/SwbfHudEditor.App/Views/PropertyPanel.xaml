<UserControl x:Class="SwbfHudEditor.App.Views.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SwbfHudEditor.App.Views"
             mc:Ignorable="d"
             Background="{StaticResource PanelBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,10,12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="PROPERTIES" Style="{StaticResource Caption}" />
                <!-- A named block: its keyword, and its name to edit. Enter or leaving the box renames it. -->
                <DockPanel x:Name="NameRow" Visibility="Collapsed" Margin="0,6,0,0">
                    <Border DockPanel.Dock="Left" CornerRadius="3" Background="{StaticResource SurfaceBrush}" Padding="7,2" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="KindText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                    </Border>
                    <TextBox x:Name="NameBox" FontFamily="{StaticResource MonoFont}" KeyDown="NameBox_KeyDown"
                             LostKeyboardFocus="NameBox_LostKeyboardFocus" />
                </DockPanel>
                <TextBlock x:Name="HeaderText" Text="Nothing selected" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                           FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Properties">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Rows" Margin="10,4,10,12" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Add">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="What the game reads for the selected block, less what it has. Click one to add it with a starting value."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="12,10,12,6" />
                    <Grid DockPanel.Dock="Top" Margin="12,0,12,6">
                        <TextBox x:Name="AddFilter" Padding="24,3,6,3" TextChanged="AddFilter_TextChanged"
                                 ToolTip="Show the properties whose name or description contains this." />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="11" HorizontalAlignment="Left" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="AddRows" Margin="10,0,10,12" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
