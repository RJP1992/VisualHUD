<Window x:Class="SwbfHudEditor.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About VisualHUD" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <StackPanel Margin="22,20,22,18">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/VisualHUD;component/Theme/VisualHUD.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="VisualHUD" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,18,0,0"
                   Text="An editor for Star Wars Battlefront II (2005) .hud files that draws a HUD the way the game does, for the stock game or for the game with BF2GameExt." />
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Made by Ryan Hank with the help of Claude, built on the original, unfinished tool by Surestsafe." />
        <TextBlock Margin="0,10,0,0">
            <Hyperlink NavigateUri="https://github.com/RJP1992/VisualHUD" RequestNavigate="Link_RequestNavigate"
                       Foreground="{StaticResource AccentBrush}">github.com/RJP1992/VisualHUD</Hyperlink>
        </TextBlock>
        <Button Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="84" Margin="0,20,0,0" />
    </StackPanel>
</Window>
