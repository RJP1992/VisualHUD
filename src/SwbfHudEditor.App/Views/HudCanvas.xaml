<UserControl x:Class="SwbfHudEditor.App.Views.HudCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SwbfHudEditor.App.Views"
             mc:Ignorable="d"
             Background="{StaticResource CanvasBrush}">
    <UserControl.Resources>
        <views:InverseBoolConverter x:Key="NotBool" />
    </UserControl.Resources>
    <DockPanel>
        <!-- What the HUD is drawn as: the game, the screen, whose view, and the text shown. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+Wheel)">
                        <TextBlock Text="&#xE71F;" Style="{StaticResource Icon}" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               MinWidth="40" TextAlignment="Center" />
                    <Button Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+Wheel)">
                        <TextBlock Text="&#xE8A3;" Style="{StaticResource Icon}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Fit_Click" ToolTip="Fit the screen in the view">
                        <TextBlock Text="&#xE9A6;" Style="{StaticResource Icon}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="ActualSize_Click" ToolTip="One screen pixel to one display pixel">
                        <TextBlock Text="1:1" FontSize="11" />
                    </Button>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Game" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="TargetCombo" SelectedIndex="0" Width="92" Margin="0,2,14,2" SelectionChanged="TargetCombo_SelectionChanged"
                              ToolTip="Which game to draw the HUD as. GameExt honours AuthoredRatio, TrueWidescreen, ScreenAnchor and FillFrom; the stock game ignores those lines and stretches the HUD on a wide screen.">
                        <ComboBoxItem Content="GameExt" />
                        <ComboBoxItem Content="Vanilla" />
                    </ComboBox>
                    <TextBlock Text="Screen" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="ScreenCombo" Width="140" Margin="0,2,14,2" SelectionChanged="ScreenCombo_SelectionChanged"
                              ToolTip="The resolution the game draws at: the back buffer, or what Shader Patch's display scaling makes the game see (1280×720 on a 4K screen at 150%). &quot;Pixels&quot; values depend on it." />
                    <TextBlock Text="View" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="ViewportCombo" SelectedIndex="0" Width="52" Margin="0,2,14,2" SelectionChanged="ViewportCombo_SelectionChanged"
                              ToolTip="Whose screen group to show: elements whose top-level Viewport is this or 0.">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Text" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <ComboBox x:Name="TextPreviewCombo" SelectedIndex="0" Width="96" Margin="0,2,14,2" SelectionChanged="TextPreviewCombo_SelectionChanged"
                              ToolTip="What text elements show before an event sets them. Examples: what the game would typically put there, and the strings of the keys. Long: long names, large numbers and paragraphs, to see how a box holds them. Keys: the keys and event names the file names.">
                        <ComboBoxItem Content="Examples" />
                        <ComboBoxItem Content="Long" />
                        <ComboBoxItem Content="Keys" />
                    </ComboBox>

                    <CheckBox x:Name="RoundingBox" Content="Snap" Style="{StaticResource Chip}" Margin="0,2,4,2"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="The draw snaps every element to a whole interface unit (1/640 of the width, 2 pixels at 1280 wide). The stock game always does; GameExt's HudSubPixel, on by default, turns it off. Switching game resets this to that game's default." />
                    <CheckBox x:Name="ShowPlaceholdersBox" Content="Outlines" IsChecked="True" Style="{StaticResource Chip}" Margin="0,2,4,2"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Outline elements that draw nothing here: missing textures, bitmaps without a BitmapRect, and the code-drawn elements' boxes." />
                    <CheckBox x:Name="GuidesBox" Content="Guides" IsChecked="True" Style="{StaticResource Chip}" Margin="0,2,4,2"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="The stock band a wide screen squashes the HUD into, or for a file GameExt lays out, its layout's thirds and how far each moves; and the boxes of texts." />
                    <CheckBox x:Name="ShowHiddenBox" Content="Hidden" Style="{StaticResource Chip}" Margin="0,2,14,2"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="With the game's showing and hiding on, draw the elements their events have not enabled faintly, so they can still be picked." />

                    <CheckBox x:Name="ReferenceBox" Content="Reference" IsEnabled="False" Style="{StaticResource Chip}" Margin="0,2,6,2"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Show the reference image loaded with File &gt; Load reference image, stretched across the screen. It is never saved into a .hud file." />
                    <Slider x:Name="ReferenceOpacitySlider" Minimum="0.1" Maximum="1.0" Value="0.5" Width="64" VerticalAlignment="Center" Margin="0,2,6,2"
                            IsEnabled="{Binding IsChecked, ElementName=ReferenceBox}" ValueChanged="ReferenceSlider_Changed"
                            ToolTip="The reference image's opacity." />
                    <CheckBox x:Name="ReferenceOnTopBox" Content="On top" Style="{StaticResource Chip}" Margin="0,2,4,2"
                              IsEnabled="{Binding IsChecked, ElementName=ReferenceBox}" Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Draw the reference image over the HUD instead of under it, to compare edges." />
                    <CheckBox x:Name="ReferenceWipeBox" Content="Wipe" Style="{StaticResource Chip}" Margin="0,2,14,2"
                              IsEnabled="{Binding IsChecked, ElementName=ReferenceBox}" Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Draw the reference image over the HUD left of a divider, and the HUD right of it: drag the divider across to compare edges." />

                    <!-- Rarely changed: in a popup. A click on the button while it is open only closes it. -->
                    <ToggleButton x:Name="MoreButton" ToolTip="HUD scale" Margin="0,2,0,2"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=MorePopup, Converter={StaticResource NotBool}}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" />
                    </ToggleButton>
                    <Popup x:Name="MorePopup" IsOpen="{Binding IsChecked, ElementName=MoreButton}" PlacementTarget="{Binding ElementName=MoreButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Closed="MorePopup_Closed">
                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,4,0,0" Width="280">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="HudScaleLabel" DockPanel.Dock="Right" Text="1.00" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="HUD scale" Style="{StaticResource Label}" />
                                </DockPanel>
                                <Slider x:Name="HudScaleSlider" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        ValueChanged="Slider_Changed" Margin="0,4,0,0"
                                        ToolTip="The runtime HUD scale (ScriptCB_SetHUDScale, set by the video options). It resizes only elements with Scalable(1), keeping their positions." />
                                <TextBlock Text="Resizes the elements with Scalable(1), as the game's video option does." Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>
            </DockPanel>
        </Border>
        <!-- How the selection's file is laid out. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CanvasBrush}" Padding="10,4">
            <TextBlock x:Name="LayoutInfoText" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </Border>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource CanvasBrush}" PreviewMouseWheel="Scroller_PreviewMouseWheel"
                      PreviewMouseDown="Scroller_PreviewMouseDown" PreviewMouseMove="Scroller_PreviewMouseMove"
                      PreviewMouseUp="Scroller_PreviewMouseUp" LostMouseCapture="Scroller_LostMouseCapture">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <Border x:Name="ViewportFrame" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                    <Border.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                    </Border.LayoutTransform>
                    <!-- Dark grid: a 20-pixel tile in screen pixels. -->
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#22262B">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#2C3137" Thickness="1" />
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="20,0" EndPoint="20,20" />
                                                <LineGeometry StartPoint="0,20" EndPoint="20,20" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                    <Canvas x:Name="CanvasSurface" ClipToBounds="True" Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp" />
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
