<Window x:Class="SwbfHudEditor.App.Views.ModToolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod tools folder" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <StackPanel Margin="18,16,18,16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." MinWidth="84" Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" FontFamily="{StaticResource MonoFont}" TextChanged="FolderBox_TextChanged" />
        </DockPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Use this folder" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="120" Click="Ok_Click" />
            <Button x:Name="SkipButton" Content="Without the mod tools" IsCancel="True" MinWidth="120" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
