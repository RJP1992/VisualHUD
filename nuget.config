<?xml version="1.0" encoding="utf-8"?>
<!-- VisualHUD restores its packages (the tests' xunit) from nuget.org only, whatever the machine's own
     NuGet sources are. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
