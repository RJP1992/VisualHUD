<UserControl x:Class="SwbfHudEditor.App.Views.EventsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBrush}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
            <CheckBox x:Name="SimulateBox" Content="Show and hide as the game does" Foreground="{StaticResource TextBrush}"
                      Checked="SimulateBox_Changed" Unchecked="SimulateBox_Changed"
                      ToolTip="Off: every element shows, but those you untick in the Elements tree, and the events you send set values, texts, colours, textures, models and positions straight away. On: an element shows only once its EventEnable event has been sent after its EventDisable one, and only while every group above it shows, as in the game." />
            <WrapPanel Margin="0,8,0,2">
                <Button Content="Initialize" Click="Initialize_Click" Margin="0,0,4,4"
                        ToolTip="Send &quot;initialize&quot;, as the HUD does when it starts." />
                <Button Content="On foot" Click="OnFoot_Click" Margin="0,0,4,4"
                        ToolTip="Send what the game would have by now for a soldier spawned on foot: initialize, spawn, weapons, full health and energy, ammo, the reticule, team reinforcements." />
                <Button Content="Show selected" Click="ShowSelected_Click" Margin="0,0,4,4"
                        ToolTip="Send the EventEnable events of the selected elements and the groups above them." />
                <Button Content="Clear" Click="Clear_Click" Margin="0,0,4,4"
                        ToolTip="Forget every event sent: every element is back in its load state, and, with the game's showing and hiding, hidden again." />
            </WrapPanel>
            <!-- Saved sets of sends. -->
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="DeleteScenario_Click" Margin="2,0,0,0"
                        ToolTip="Forget the scenario named in the box.">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                </Button>
                <Button DockPanel.Dock="Right" Content="Save" Click="SaveScenario_Click" Margin="4,0,0,0" Padding="10,2"
                        ToolTip="Save the events sent so far, with their times on the clock, under the name in the box. A name already used is replaced." />
                <ComboBox x:Name="ScenarioBox" IsEditable="True" SelectionChanged="ScenarioBox_SelectionChanged"
                          ToolTip="Scenarios: the events sent so far, saved under a name. Pick one to send it again in place of what is sent now; type a name and Save to keep the current one." />
            </DockPanel>
            <!-- The clock: the sends replayed at their times, a frame at a time. -->
            <DockPanel Margin="0,2,0,6">
                <ToggleButton x:Name="PlayButton" DockPanel.Dock="Left" Click="Play_Click"
                              ToolTip="Run the clock: fades, eased colours, pulses, change strips and lerps play out as the game plays them, at 60 frames a second. A send is made at the clock's time.">
                    <TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Icon}" />
                </ToggleButton>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="Rewind_Click" Margin="2,0,6,0"
                        ToolTip="Back to 0 s, keeping the sends: they play again at their times.">
                    <TextBlock Text="&#xE892;" Style="{StaticResource Icon}" />
                </Button>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Text="0.00 s" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}" Margin="6,0,0,0" />
                <Slider x:Name="ClockSlider" Minimum="0" Maximum="10" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        ValueChanged="ClockSlider_ValueChanged" PreviewMouseDown="ClockSlider_PreviewMouseDown"
                        ToolTip="The clock's time: drag to see the HUD at any moment of the sends." />
            </DockPanel>
            <Grid Margin="0,2,0,0">
                <TextBox x:Name="FilterBox" Padding="24,3,6,3" TextChanged="FilterBox_TextChanged"
                         ToolTip="Show events whose name contains this." />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="11" HorizontalAlignment="Left" Margin="8,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Text="Type a value and press Enter, or Send to send it again (it then counts as the latest). It is sent at the clock's time; what it sets shows at once, and with the clock running fades and easing play out. It shows or hides elements only with the box above ticked." Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <ListBox x:Name="EventList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="ToolTip" Value="{Binding Details}" />
                    <Setter Property="Padding" Value="10,5,10,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Order}" Foreground="{StaticResource WarningBrush}" MinWidth="22" FontSize="11"
                                   VerticalAlignment="Center" ToolTip="The order in which it was sent." />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" Foreground="{Binding NameBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding TypeName}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Send" Click="Send_Click" Padding="10,1" Margin="6,0,0,0"
                                    ToolTip="Send it again with this value." />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Current}" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="11" Margin="8,0,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="The value it has now." />
                            <ComboBox IsEditable="True" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding Suggestions}" KeyDown="Value_KeyDown"
                                      SelectionChanged="Value_SelectionChanged" />
                        </DockPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
