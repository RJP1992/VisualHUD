<Window x:Class="SwbfHudEditor.App.Views.NewHudDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New HUD file" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="Folder" Style="{StaticResource Caption}" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" />
        </DockPanel>
        <TextBlock Text="The game reads a mod's HUD files from its data folder's Common\hud, where the editor also finds their textures, models, fonts and strings."
                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />

        <TextBlock Text="File name" Style="{StaticResource Caption}" Margin="0,0,0,4" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text=".hud" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Text="new_hud" />
        </DockPanel>

        <TextBlock Text="Laid out" Style="{StaticResource Caption}" Margin="0,14,0,6" />
        <RadioButton x:Name="StockLayout" GroupName="Layout" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" IsChecked="True">
            <TextBlock TextWrapping="Wrap">Stock: written for 4:3, stretched across a wide screen, as every stock file is</TextBlock>
        </RadioButton>
        <RadioButton x:Name="TrueWidescreenLayout" GroupName="Layout" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6">
            <TextBlock TextWrapping="Wrap">GameExt TrueWidescreen: written for 4:3, drawn at the screen's real height</TextBlock>
        </RadioButton>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="AuthoredLayout" GroupName="Layout" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center">
                <TextBlock>GameExt AuthoredRatio: written for</TextBlock>
            </RadioButton>
            <TextBox x:Name="RatioWidth" Text="16" Width="36" Margin="8,0,4,0" HorizontalContentAlignment="Center" />
            <TextBlock Text=":" VerticalAlignment="Center" />
            <TextBox x:Name="RatioHeight" Text="9" Width="36" Margin="4,0,0,0" HorizontalContentAlignment="Center" />
        </StackPanel>

        <CheckBox x:Name="AddToOpenBox" Content="Add it to the open HUD, loaded after its files" Margin="0,16,0,0" IsChecked="True" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Create" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="84" Click="Create_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
