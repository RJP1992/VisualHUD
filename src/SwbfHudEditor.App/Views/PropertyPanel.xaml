<UserControl x:Class="SwbfHudEditor.App.Views.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E1E">
    <UserControl.Resources>
        <!-- Compact vertical tab strip (Blender-style side tabs). Default WPF TabItem is chunky
             and unreadable when rotated; override the template so each tab is a narrow clickable
             pill with the tab's label running top-to-bottom. -->
        <Style x:Key="VerticalTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2c3440" />
                                <Setter Property="Foreground" Value="#d4e8ff" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252a30" />
                                <Setter Property="Foreground" Value="#ddd" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#222" Padding="8,6" BorderBrush="#333" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="PROPERTIES" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                <TextBlock x:Name="HeaderText" Text="(no selection)" Foreground="#ddd"
                           FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <TabControl TabStripPlacement="Left" Background="#1E1E1E" BorderThickness="0" Padding="0">
            <TabItem Header="EDIT" Style="{StaticResource VerticalTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#1E1E1E" BorderThickness="0">
                    <StackPanel x:Name="Rows" Margin="6" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="ADD" Style="{StaticResource VerticalTabItem}">
                <DockPanel Background="#1E1E1E">
                    <TextBlock DockPanel.Dock="Top" Text="Insert a property into the selected element. Only properties valid for this element type and not already present are shown."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="8,8,8,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="#1E1E1E" BorderThickness="0">
                        <StackPanel x:Name="AddRows" Margin="6" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
