<Window x:Class="SwbfHudEditor.App.Views.RepeatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repeat" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">
    <StackPanel Margin="18,16,18,16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Copies of the selection in a row, each a step further on the screen than the last, named as Duplicate names copies. Sums work, as 64*2." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Copies" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox x:Name="CountBox" Grid.Column="1" Text="3" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Text="Step across (pixels)" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox x:Name="AcrossBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Text="Step down (pixels)" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="DownBox" Grid.Row="2" Grid.Column="1" Text="0" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Repeat" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="84" Click="Repeat_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
