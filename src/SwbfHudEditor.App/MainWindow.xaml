<Window x:Class="SwbfHudEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hud="clr-namespace:SwbfHudEditor.Core.Hud;assembly=SwbfHudEditor.Core"
        xmlns:views="clr-namespace:SwbfHudEditor.App.Views"
        xmlns:local="clr-namespace:SwbfHudEditor.App"
        mc:Ignorable="d"
        Title="VisualHUD" Height="800" Width="1400"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Dark theme applied to every TreeViewItem so the label text keeps its intended color
             (orange for event groups, light blue for blocks) instead of the default system
             selection foreground. Background stays dark gray; hover/selection keeps the same
             subtle highlight seen in other dark editors.
             Preview-click handler ensures clicking ANYWHERE in the row (including the checkbox)
             selects the item first — default WPF lets the CheckBox eat the click, which left
             users pressing H on what looked like a selection but actually wasn't. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#d4e8ff" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3a4552" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <views:ElementsOnlyConverter x:Key="ElementsOnly" />
        <!-- A block of the file, in file order, with the elements it holds nested under it (its
             property lines are in the Properties panel): the per-element visibility toggle and
             the block as written. -->
        <HierarchicalDataTemplate DataType="{x:Type hud:HudBlock}" ItemsSource="{Binding Children, Converter={StaticResource ElementsOnly}}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Margin="0,0,4,0" VerticalAlignment="Center"
                          ToolTip="Show/hide this element (and its descendants) on the canvas"
                          Click="VisibilityCheckBox_Click" />
                <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                           Foreground="#7fc3ff" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="Open_Click" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Reload current file" Click="Reload_Click" InputGestureText="F5"
                          ToolTip="Re-parse the current .hud from disk, discarding any unsaved edits. Useful after editing externally." />
                <Separator />
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{x:Static ApplicationCommands.Undo}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{x:Static ApplicationCommands.Redo}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Delete selected" Click="DeleteSelected_Click" InputGestureText="Del" />
                <MenuItem Header="Insert _top-level element">
                    <MenuItem Header="Group" Click="InsertTopLevel_Group_Click" />
                    <MenuItem Header="Bitmap" Click="InsertTopLevel_Bitmap_Click" />
                    <MenuItem Header="BarBitmap" Click="InsertTopLevel_BarBitmap_Click" />
                    <MenuItem Header="Text" Click="InsertTopLevel_Text_Click" />
                    <MenuItem Header="Model3D" Click="InsertTopLevel_Model3D_Click" />
                </MenuItem>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. Open a .hud file to begin." />
            </StatusBarItem>
            <Separator Margin="8,0" />
            <StatusBarItem>
                <TextBlock x:Name="HoverText" Text="" Foreground="#888" FontFamily="Consolas, Cascadia Mono, Menlo, monospace" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" Background="#252a30" BorderThickness="0" Padding="0">
                <TabItem Header="Elements">
                <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          Background="#252a30" Foreground="#d4e8ff" BorderThickness="0">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Insert child">
                                <MenuItem Header="Group" Click="InsertChild_Group_Click" />
                                <MenuItem Header="Bitmap" Click="InsertChild_Bitmap_Click" />
                                <MenuItem Header="BarBitmap" Click="InsertChild_BarBitmap_Click" />
                                <MenuItem Header="Text" Click="InsertChild_Text_Click" />
                                <MenuItem Header="Model3D" Click="InsertChild_Model3D_Click" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Delete" Click="DeleteSelected_Click" InputGestureText="Del" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
                </TabItem>
                <TabItem Header="Events">
                    <views:EventsPanel x:Name="EventsList" />
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#333" ResizeBehavior="PreviousAndNext" />
            <views:HudCanvas x:Name="Canvas" Grid.Column="2"
                             BlockSelected="Canvas_BlockSelected"
                             HoverInfoChanged="Canvas_HoverInfoChanged"
                             BlockDragged="Canvas_BlockDragged"
                             BlockDragCommitted="Canvas_BlockDragCommitted" />
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#333" ResizeBehavior="PreviousAndNext" />
            <views:PropertyPanel x:Name="Properties" Grid.Column="4"
                                 PropertyEdited="Properties_PropertyEdited"
                                 PropertyInsertRequested="Properties_PropertyInsertRequested"
                                 PropertyDeleteRequested="Properties_PropertyDeleteRequested" />
        </Grid>
    </DockPanel>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{x:Static ApplicationCommands.Save}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{x:Static ApplicationCommands.SaveAs}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{x:Static ApplicationCommands.Undo}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{x:Static ApplicationCommands.Redo}" />
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{x:Static ApplicationCommands.Redo}" />
        <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
        <KeyBinding Key="H" Command="{x:Static local:MainWindow.ToggleHideSelectedCommand}" />
        <KeyBinding Modifiers="Alt" Key="H" Command="{x:Static local:MainWindow.UnhideAllCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="Open_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="Save_Executed" CanExecute="Save_CanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="SaveAs_Executed" CanExecute="Save_CanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
        <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="Reload_Executed" CanExecute="Reload_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.ToggleHideSelectedCommand}" Executed="ToggleHideSelected_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.UnhideAllCommand}" Executed="UnhideAll_Executed" />
    </Window.CommandBindings>
</Window>
